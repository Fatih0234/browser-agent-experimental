      "name": "Create New Shipment",
      "category": "logistics",
      "critical": true,
      "depends_on": ["task-001", "task-008"],
      "description": "Navigate to Logistics, fill out the new shipment form with carrier, service type, addresses, and create a shipment",
      "steps": [
        { "order": 1, "action": "navigate", "target": "/demo-org/logistics/new", "expected_state": "New shipment form loaded" },
        { "order": 2, "action": "select", "target": "#carrier", "value": "dhl", "expected_state": "DHL selected" },
        { "order": 3, "action": "select", "target": "#service-type", "value": "express", "expected_state": "Express selected" },
        { "order": 4, "action": "fill", "target": "#weight", "value": "3.5" },
        { "order": 5, "action": "fill", "target": "#origin-name", "value": "Test GmbH" },
        { "order": 6, "action": "fill", "target": "#origin-street", "value": "Teststraße 1" },
        { "order": 7, "action": "fill", "target": "#origin-zip", "value": "10115" },
        { "order": 8, "action": "fill", "target": "#origin-city", "value": "Berlin" },
        { "order": 9, "action": "fill", "target": "#destination-name", "value": "Empfänger GmbH" },
        { "order": 10, "action": "fill", "target": "#destination-street", "value": "Zielweg 5" },
        { "order": 11, "action": "fill", "target": "#destination-zip", "value": "80331" },
        { "order": 12, "action": "fill", "target": "#destination-city", "value": "München" },
        { "order": 13, "action": "click", "target": "button:has-text('Create Shipment')", "expected_state": "Shipment created, redirected to detail" },
        { "order": 14, "action": "verify", "assertions": ["Tracking number visible", "Status shows 'draft'", "DHL badge visible"] }
      ],
      "pass_criteria": ["Shipment created successfully", "Redirected to shipment detail page", "Tracking number assigned"],
      "scoring": { "time_weight": 1.0, "retry_penalty": 0.1, "max_retries": 3 }
    },
